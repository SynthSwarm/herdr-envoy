{
  "name": "herdr-envoy",
  "version": "0.1.0",
  "description": "opencode plugin for bounded tasks and durable interactive peer sessions in isolated git worktrees, using herdr panes or child workspaces. Ships delegation tools, an /envoy command and coordinator guidance, with explicit handback and cleanup.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agent",
    "delegation",
    "orchestration",
    "envoy",
    "git-worktree",
    "herdr"
  ],
  "license": "MIT",
  "author": "Quintin De Kok",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SynthSwarm/herdr-envoy.git"
  },
  "homepage": "https://github.com/SynthSwarm/herdr-envoy#readme",
  "bugs": {
    "url": "https://github.com/SynthSwarm/herdr-envoy/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:bun": "npm run build && bun test test/bun-shell.test.ts",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include='dist/*.js' --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=95 test/*.test.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.17.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.4",
    "@types/node": "^26.1.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
